__pycache__/
*.pyc
*.pyo

# Secrets / env
.env
.venv/
venv/

# Data: the authoritative DB and all raw artifacts stay out of git.
# The raw columns inside kyb.db are the permanent record; original bulk
# files are re-downloadable from official sources (see ingest/ pipelines).
data/

# Logs
*.log

# Generated site artifacts (rebuilt by render/ pipelines; only the
